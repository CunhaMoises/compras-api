// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model usuarios {
  id String @id @default(uuid())
  nome String
  email String @unique
  senha String 
  login Boolean @default(false)

  carrinhos carrinhos []
  codigo verificacao_email?
}

model verificacao_email {
  id String @id @default(uuid())
  codigo String 
  expiraEM DateTime
  tentativas Int @default(0)
  usadoEM DateTime?

  usuario_id String @unique
  usuarios usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}


model carrinhos {
  id String @id @default(uuid())
  status String @default("ativo")
  total Float @default(0)
  createdAt DateTime @default(now())

  usuario_id String
  usuarios usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  itens itens_carrinho []
}


model itens_carrinho {
  id String @id @default(uuid())
  nome String
  preco Float
  quantidade Int

  carrinho_id String
  carrinho carrinhos @relation(fields: [carrinho_id], references: [id], onDelete: Cascade)
}